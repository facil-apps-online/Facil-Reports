# Reporting API - Environment Variables
# Copy this file to .env and fill in the values

# Generate API keys with: openssl rand -hex 32

# Glamtica
GLAMTICA_API_KEY=glamtica_live_GENERATE_WITH_OPENSSL
GLAMTICA_SUPABASE_URL=https://your-project.supabase.co
GLAMTICA_SUPABASE_KEY=your_anon_key
GLAMTICA_SUPABASE_SERVICE_KEY=your_service_role_key

# TattooSuite
TATTOOSUITE_API_KEY=tattoosuite_live_GENERATE_WITH_OPENSSL
TATTOOSUITE_SUPABASE_URL=https://your-project.supabase.co
TATTOOSUITE_SUPABASE_KEY=your_anon_key
TATTOOSUITE_SUPABASE_SERVICE_KEY=your_service_role_key

