# Facil Reports - Variables de Entorno
# Copiar a .env y configurar

# Core (fuente dinámica de configuración de plataformas)
# La edge function get-platform-reporting-config de Core resuelve las plataformas
CORE_URL=https://lvdrwumtbhvbtolqgrwi.supabase.co
CORE_SERVICE_SECRET=CHANGE_ME_CORE_SERVICE_SECRET
CORE_CACHE_TTL=00:10:00

# Admin Secret (para generar/revocar API keys)
ADMIN_SECRET=CHANGE_ME_TO_A_SECURE_SECRET

# App URL pública
APP_URL=https://reports.facil-apps.online

# API Keys por Plataforma (generar con: openssl rand -hex 12)
# Se resuelven dinámicamente desde Core (platform_reporting_config)
