<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastReport.OpenSource" Version="2026.2.8" />
    <PackageReference Include="FastReport.OpenSource.Export.PdfSimple" Version="2026.2.8" />
    <!-- Exportador PDF vectorial propio (SkiaPdfExport): texto real, fuentes embebidas y QR vectorial.
         3.x: el PDF de 2.88 no recortaba fuentes. NoDependencies: sin requerir fontconfig/freetype del sistema. -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <!-- Generación local del código QR (antes se llamaba a api.qrserver.com). MIT. -->
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <!-- Version fijada a lo que cubre nuestra licencia actual (suscripción v22) — ver
         devexpress-support-reply-2.txt. DevExpress.Drawing.Skia no existe en esta serie; el
         paquete DevExpress.Drawing (dependencia transitiva de AspNetCore.Reporting) trae su
         propio renderizador multiplataforma sin depender de SkiaSharp ni de libgdiplus. -->
    <PackageReference Include="DevExpress.AspNetCore.Reporting" Version="22.1.15" />
    <!-- Requerido por DevExpress Reporting: el modelo del Report Designer se serializa con
         converters propios de Json.NET (ej. CultureInfo, tipos polimórficos) — sin esto,
         System.Text.Json (el serializador por defecto) produce JSON corrupto/incompleto. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.*" />
  </ItemGroup>

</Project>
